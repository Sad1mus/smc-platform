# ──────────────────────────────────────────────────────────────
# SMC — Plataforma de Visualización de Mercados
# Copia este archivo a .env.local y completa los valores.
# NUNCA commitear .env.local ni claves reales.
# ──────────────────────────────────────────────────────────────

# ── Supabase (Auth + PostgreSQL) ──────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
# Solo servidor (webhooks / admin). JAMÁS exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# ── Stripe (TEST mode durante todo el MVP) ────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── App ───────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Observabilidad (opcional en desarrollo) ───────────────────
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# ── Emails transaccionales (opcional en desarrollo) ───────────
RESEND_API_KEY=
