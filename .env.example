# ──────────────────────────────────────────────────────────────
# SMC — Plataforma de Visualización de Mercados
# Copia este archivo a .env.local y completa los valores.
# NUNCA commitear .env.local ni claves reales.
# ──────────────────────────────────────────────────────────────

# ── Supabase (Auth + PostgreSQL) ──────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
# Solo servidor (webhooks / admin). JAMÁS exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# ── Stripe (TEST mode durante todo el MVP) ────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── App ───────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Shell nativo (Fase 2 — solo aplica dentro de la app móvil) ─
# Gate biométrico al abrir el dashboard en la app nativa. En navegador no tiene efecto.
NEXT_PUBLIC_ENABLE_BIOMETRIC_GATE=false

# ── KYC (flag-gated, default off — ver docs/specs/kyc.md) ─────
# Muestra la verificación de identidad en /dashboard/plan (proveedor stub en Fase 1).
NEXT_PUBLIC_ENABLE_KYC=false

# ── Observabilidad (opcional en desarrollo) ───────────────────
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# ── Emails transaccionales (opcional en desarrollo) ───────────
# Sin RESEND_API_KEY los emails funcionan en modo stub (solo logs).
RESEND_API_KEY=
EMAIL_FROM="SMC <onboarding@resend.dev>"
